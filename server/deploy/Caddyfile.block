# WhisperLoom Firmen-Manager — Demo (systemd --user whisperloom-admin, 127.0.0.1:8099). Sicherheits-Header (CSP, HSTS,
# nosniff, Referrer-Policy) setzt die App selbst; Audio über den Proxy bis 25 MiB (+ Multipart), die App prüft genauer.
whisperloom-admin.{$SITE_HOST} {
	import subsite
	request_body {
		max_size 26MB
	}
	reverse_proxy 127.0.0.1:8099
}
