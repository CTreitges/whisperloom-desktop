# Umgebung der Demo-Instanz (W2-DEMO). setup-demo.sh legt daraus ~/.config/whisperloom-admin/env an (Rechte 600).
# Den Platzhalter HOME in @…@ ersetzt das Skript durch das Home-Verzeichnis. Keine Keys hier: Keys trägt man im Portal ein.
# Nur einfache Werte NAME=wert ohne Leerzeichen, Quotes oder $: systemd (EnvironmentFile) und wl-admin (sh) lesen die
# Datei verschieden und sehen nur so dieselbe Konfiguration.
WL_DATA_DIR=@HOME@/whisperloom-admin/data
WL_BASE_URL=https://whisperloom-admin.ctreitges.de
# Zwei-Faktor freiwillig, beim ersten Login überspringbar (Standard). Pflicht für alle: WL_AUTH_MODES=password_totp.
WL_AUTH_MODES=password_totp,password
# Caddy auf demselben Rechner: nur seine Adresse, damit X-Forwarded-For (Rate-Limits) gilt.
WL_TRUSTED_PROXIES=127.0.0.1/32
# Hauptschlüssel getrennt vom Datenordner (Backups des Datenordners enthalten ihn so nicht).
WL_MASTER_KEY_FILE=@HOME@/.config/whisperloom-admin/master.key
# SSRF-Freigabe für den Fake-Anbieter auf einer eigenen Loopback-Adresse, nicht für 127.0.0.1 (dort lauschen andere
# Dienste, u. a. die Caddy-Admin-API). Immer mit Port (W2-SFIX): dann gilt sie nur für den Fake-Anbieter, nicht für
# andere Dienste auf 0.0.0.0 (sshd, rpcbind, Dev-Server). Ohne Port gälte sie für alle Ports dieser IP.
WL_UPSTREAM_ALLOW=127.0.0.2:8100
# Nur für wl-admin (demo-fake-*): Adresse des Fake-Anbieters, muss zu whisperloom-admin-fake.service passen.
WL_DEMO_FAKE=127.0.0.2:8100
