[Unit]
Description=WhisperLoom Firmen-Manager - Demo-Instanz (FastAPI/uvicorn)
After=network.target

[Service]
# exec: scheitert der Start (fehlendes venv), meldet enable --now das sofort
Type=exec
WorkingDirectory=%h/whisperloom-admin/app/server
# Ohne env scheitert der Start (gewollt: erst setup-demo.sh)
EnvironmentFile=%h/.config/whisperloom-admin/env
ExecStart=%h/whisperloom-admin/venv/bin/python -m whisperloom_server serve --host 127.0.0.1 --port 8099
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
