<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
        xmlns:vs="using:WhisperLoom.App.Views.Settings"
        xmlns:ds="using:WhisperLoom.App.Design"
        xmlns:l="using:WhisperLoom.App.Localization"
        x:Class="WhisperLoom.App.Views.SettingsWindow"
        x:DataType="vm:SettingsShellViewModel"
        Classes="loom"
        Title="{Binding [Settings_Title], Source={x:Static l:Loc.Instance}}"
        Icon="/Assets/whisperloom.ico"
        Width="920" Height="660" MinWidth="720" MinHeight="480">
  <!--
    Hülle nach HIG „Settings“/„Sidebars“: links Suche + Seitenleiste (Pfeiltasten), rechts die Seite. Kein Speichern-Knopf –
    jede Änderung gilt sofort. Esc schließt (bzw. leert zuerst die Suche), Strg+F springt in die Suche.
  -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:GeneralPageViewModel"><vs:GeneralPage /></DataTemplate>
    <DataTemplate DataType="vm:RecognitionPageViewModel"><vs:RecognitionPage /></DataTemplate>
    <DataTemplate DataType="vm:TextPageViewModel"><vs:TextPage /></DataTemplate>
    <DataTemplate DataType="vm:ProvidersPageViewModel"><vs:ProvidersPage /></DataTemplate>
    <DataTemplate DataType="vm:LocalModelsPageViewModel"><vs:LocalModelsPage /></DataTemplate>
    <DataTemplate DataType="vm:CleanupPageViewModel"><vs:CleanupPage /></DataTemplate>
    <DataTemplate DataType="vm:OutputPageViewModel"><vs:OutputPage /></DataTemplate>
    <DataTemplate DataType="vm:HotkeysPageViewModel"><vs:HotkeysPage /></DataTemplate>
    <DataTemplate DataType="vm:PrivacyPageViewModel"><vs:PrivacyPage /></DataTemplate>
    <DataTemplate DataType="vm:NetworkPageViewModel"><vs:NetworkPage /></DataTemplate>
    <DataTemplate DataType="vm:CompanyPageViewModel"><vs:CompanyPage /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="232,*" ds:Managed.Context="{Binding Managed}">
    <Border Grid.Column="0" Background="{DynamicResource Loom.Sidebar}" BorderBrush="{DynamicResource Loom.Separator}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12,14,12,6" Text="{Binding SearchText}"
                 PlaceholderText="{Binding [Search_Placeholder], Source={x:Static l:Loc.Instance}}"
                 AutomationProperties.Name="{Binding [Search_Name], Source={x:Static l:Loc.Instance}}">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{DynamicResource Loom.Icon.Search}" Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource Loom.TextSecondary}" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Panel>
          <ListBox x:Name="PageList" Classes="sidebar" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                   IsVisible="{Binding !IsSearching}" AutomationProperties.Name="{Binding [Sidebar_Name], Source={x:Static l:Loc.Instance}}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:SettingsPageViewModel">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsPageViewModel">
                <StackPanel>
                  <TextBlock Classes="section" Text="{Binding SectionTitle}" IsVisible="{Binding SectionTitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Border Classes="sideItem">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Border Classes="tile" Background="{Binding Tile, Converter={x:Static ds:ResourceKeyConverter.Instance}}">
                        <PathIcon Data="{Binding Icon, Converter={x:Static ds:ResourceKeyConverter.Instance}}" />
                      </Border>
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource Loom.Text}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <DockPanel IsVisible="{Binding IsSearching}">
            <TextBlock DockPanel.Dock="Top" x:Name="NoResults" Classes="section" TextWrapping="Wrap"
                       Text="{Binding [Search_None], Source={x:Static l:Loc.Instance}}"
                       IsVisible="{Binding !Results.Count}" />
            <ListBox x:Name="ResultList" Classes="sidebar" ItemsSource="{Binding Results}"
                     AutomationProperties.Name="{Binding [Search_Results], Source={x:Static l:Loc.Instance}}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem" x:DataType="vm:SearchResult">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResult">
                  <Border Classes="sideItem">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Location}" FontSize="{DynamicResource Loom.Font.Caption}"
                                 Foreground="{DynamicResource Loom.TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- PERF-2: Vorlage = PageViewCache (Code-Behind), Views werden je Seite wiederverwendet. -->
    <!-- Vorbau (PERF-2): Seiten hängen hier nur kurz (wenige Dispatcher-Durchläufe), unsichtbar, ohne Treffer und Tab-Stopps. -->
    <Panel x:Name="Staging" Grid.Column="1" IsHitTestVisible="False" Opacity="0" KeyboardNavigation.TabNavigation="None" />
    <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding SelectedPage}" />
  </Grid>
</Window>
