<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhisperLoom.App.ViewModels"
        xmlns:v="using:WhisperLoom.App.Views"
        xmlns:l="using:WhisperLoom.App.Localization"
        x:Class="WhisperLoom.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding [Settings_Title], Source={x:Static l:Loc.Instance}}"
        Icon="/Assets/whisperloom.ico"
        Width="900" Height="680"
        Background="{StaticResource WlBackground}">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource WlAccent}" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
    <Style Selector="TextBlock.f">
      <Setter Property="Foreground" Value="{StaticResource WlOnSurfaceVariant}" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector="ComboBox, TextBox">
      <Setter Property="MinWidth" Value="320" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
      <Button x:Name="SaveButton" Content="{Binding [Action_Save], Source={x:Static l:Loc.Instance}}" Command="{Binding SaveCommand}" />
      <Button Content="{Binding [Action_Close], Source={x:Static l:Loc.Instance}}" Click="OnClose" />
      <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Foreground="{StaticResource WlAccent}" />
    </StackPanel>

    <TextBlock x:Name="PolicyHint" DockPanel.Dock="Top" IsVisible="{Binding HasPolicy}" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{StaticResource WlAccent}" Text="{Binding [Policy_Hint], Source={x:Static l:Loc.Instance}}" />

    <TabControl>
      <!-- Erkennung -->
      <TabItem x:Name="TabRecognition" Header="{Binding [Settings_Recognition], Source={x:Static l:Loc.Instance}}">
        <ScrollViewer>
          <StackPanel Margin="4">
            <TextBlock Classes="f" Text="{Binding [Settings_Provider], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[stt.providerId]}" ItemsSource="{Binding SttProviders}" SelectedItem="{Binding SttProvider}" />
            <TextBlock Classes="f" Text="{Binding [Settings_ApiKey], Source={x:Static l:Loc.Instance}}" />
            <v:KeyFieldView x:Name="SttKeyView" DataContext="{Binding SttKey}" />
            <TextBlock Classes="f" Text="{Binding [Settings_BaseUrl], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[stt.baseUrl]}" Text="{Binding SttBaseUrl}" />
            <TextBlock Classes="f" Text="{Binding [Settings_Model], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[stt.model]}" Text="{Binding SttModel}" />
            <TextBlock Classes="f" Text="{Binding [Language_Label], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[language]}" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
            <TextBlock Classes="h" Text="{Binding [Settings_Fallback], Source={x:Static l:Loc.Instance}}" />
            <CheckBox IsEnabled="{Binding Editable[sttFallback.enabled]}" IsChecked="{Binding SttFallbackEnabled}" Content="{Binding [Settings_FallbackEnabled], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[sttFallback.providerId]}" ItemsSource="{Binding SttProviders}" SelectedItem="{Binding SttFallbackProvider}" />
            <v:KeyFieldView x:Name="SttFallbackKeyView" DataContext="{Binding SttFallbackKey}" />
            <TextBlock Classes="f" Text="{Binding [Settings_Model], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[sttFallback.model]}" Text="{Binding SttFallbackModel}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Text -->
      <TabItem x:Name="TabText" Header="{Binding [Settings_Text], Source={x:Static l:Loc.Instance}}">
        <ScrollViewer>
          <StackPanel Margin="4">
            <TextBlock Classes="f" Text="{Binding [Stage_Label], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[refine.stage]}" ItemsSource="{Binding Stages}" SelectedItem="{Binding Stage}" />
            <CheckBox IsEnabled="{Binding Editable[refine.promptEnabled]}" IsChecked="{Binding PromptEnabled}" Content="{Binding [Settings_PromptEnabled], Source={x:Static l:Loc.Instance}}" />
            <TextBlock Classes="h" Text="{Binding [Settings_LlmAccess], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[llm.providerId]}" ItemsSource="{Binding LlmProviders}" SelectedItem="{Binding LlmProvider}" />
            <v:KeyFieldView x:Name="LlmKeyView" DataContext="{Binding LlmKey}" />
            <TextBlock Classes="f" Text="{Binding [Settings_BaseUrl], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.baseUrl]}" Text="{Binding LlmBaseUrl}" />
            <TextBlock Classes="f" Text="{Binding [Settings_Model], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.model]}" Text="{Binding LlmModel}" />
            <TextBlock Classes="h" Text="{Binding [Settings_StageModels], Source={x:Static l:Loc.Instance}}" />
            <TextBlock Classes="f" Text="{Binding [Stage_polish], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.stageModels.polish]}" Text="{Binding ModelPolish}" />
            <TextBlock Classes="f" Text="{Binding [Stage_beautify], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.stageModels.beautify]}" Text="{Binding ModelBeautify}" />
            <TextBlock Classes="f" Text="{Binding [Stage_summarize], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.stageModels.summarize]}" Text="{Binding ModelSummarize}" />
            <TextBlock Classes="f" Text="{Binding [Stage_prompt], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llm.stageModels.prompt]}" Text="{Binding ModelPrompt}" />
            <TextBlock Classes="h" Text="{Binding [Settings_Fallback], Source={x:Static l:Loc.Instance}}" />
            <CheckBox IsEnabled="{Binding Editable[llmFallback.enabled]}" IsChecked="{Binding LlmFallbackEnabled}" Content="{Binding [Settings_FallbackEnabled], Source={x:Static l:Loc.Instance}}" />
            <ComboBox IsEnabled="{Binding Editable[llmFallback.providerId]}" ItemsSource="{Binding LlmFallbackProviders}" SelectedItem="{Binding LlmFallbackProvider}" />
            <v:KeyFieldView x:Name="LlmFallbackKeyView" DataContext="{Binding LlmFallbackKey}" />
            <TextBlock Classes="f" Text="{Binding [Settings_Model], Source={x:Static l:Loc.Instance}}" />
            <TextBox IsEnabled="{Binding Editable[llmFallback.model]}" Text="{Binding LlmFallbackModel}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Lokal (WLD-P4b) -->
      <TabItem x:Name="TabLocal" Header="{Binding [Settings_Local], Source={x:Static l:Loc.Instance}}">
        <v:LocalSettingsView DataContext="{Binding Local}" />
      </TabItem>

      <!-- Kontext-Wörter -->
      <TabItem x:Name="TabVocabulary" Header="{Binding [Settings_Vocabulary], Source={x:Static l:Loc.Instance}}">
        <StackPanel Margin="4">
          <TextBlock Classes="f" Text="{Binding [Settings_VocabularyHint], Source={x:Static l:Loc.Instance}}" />
          <TextBox IsEnabled="{Binding Editable[stt.vocabulary]}" Text="{Binding Vocabulary}" AcceptsReturn="True" Height="260" MinWidth="560" TextWrapping="Wrap" />
          <TextBlock Classes="f" Text="{Binding [Settings_VocabularyFile], Source={x:Static l:Loc.Instance}}" />
          <TextBox IsEnabled="{Binding Editable[stt.vocabularyFile]}" Text="{Binding VocabularyFile}" MinWidth="560" />
        </StackPanel>
      </TabItem>

      <!-- Netzwerk -->
      <TabItem x:Name="TabNetwork" Header="{Binding [Settings_Network], Source={x:Static l:Loc.Instance}}">
        <StackPanel Margin="4">
          <TextBlock Classes="f" Text="{Binding [Settings_Proxy], Source={x:Static l:Loc.Instance}}" />
          <ComboBox IsEnabled="{Binding Editable[desktop.proxyMode]}" ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode}" />
          <TextBlock Classes="f" Text="{Binding [Settings_ProxyUrl], Source={x:Static l:Loc.Instance}}" />
          <TextBox IsEnabled="{Binding Editable[desktop.proxyUrl]}" Text="{Binding ProxyUrl}" PlaceholderText="http://proxy:3128" />
        </StackPanel>
      </TabItem>

      <!-- Datenschutz -->
      <TabItem x:Name="TabPrivacy" Header="{Binding [Settings_Privacy], Source={x:Static l:Loc.Instance}}">
        <StackPanel Margin="4">
          <CheckBox IsEnabled="{Binding Editable[history.enabled]}" IsChecked="{Binding HistoryEnabled}" Content="{Binding [Settings_HistoryEnabled], Source={x:Static l:Loc.Instance}}" />
          <TextBlock Classes="f" Text="{Binding [Settings_HistorySize], Source={x:Static l:Loc.Instance}}" />
          <ComboBox IsEnabled="{Binding Editable[history.size]}" ItemsSource="{Binding HistorySizes}" SelectedItem="{Binding HistorySize}" />
          <TextBlock Classes="f" TextWrapping="Wrap" Text="{Binding [Settings_PrivacyNote], Source={x:Static l:Loc.Instance}}" />
          <TextBlock Classes="h" Text="{Binding [Settings_KeyStore], Source={x:Static l:Loc.Instance}}" />
          <TextBlock x:Name="SecretStoreKindText" Text="{Binding SecretStoreKind}" />
          <TextBlock x:Name="SecretFileHint" IsVisible="{Binding SecretStoreIsFile}" TextWrapping="Wrap"
                     Foreground="{StaticResource WlError}" Text="{Binding [Settings_KeyFileHint], Source={x:Static l:Loc.Instance}}" />
        </StackPanel>
      </TabItem>

      <!-- Ausgabe und Oberfläche -->
      <TabItem x:Name="TabOutput" Header="{Binding [Settings_Output], Source={x:Static l:Loc.Instance}}">
        <StackPanel Margin="4">
          <TextBlock Classes="f" Text="{Binding [Settings_Output], Source={x:Static l:Loc.Instance}}" />
          <ComboBox IsEnabled="{Binding Editable[desktop.output]}" ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" />
          <TextBlock Classes="f" Text="{Binding [Settings_InsertMode], Source={x:Static l:Loc.Instance}}" IsVisible="{Binding Hotkeys.Available}" />
          <ComboBox x:Name="InsertModeBox" ItemsSource="{Binding InsertModes}" SelectedItem="{Binding InsertMode}" IsVisible="{Binding Hotkeys.Available}" />
          <TextBlock Classes="f" Text="{Binding [Settings_Microphone], Source={x:Static l:Loc.Instance}}" />
          <ComboBox IsEnabled="{Binding Editable[desktop.microphone]}" ItemsSource="{Binding Microphones}" SelectedItem="{Binding Microphone}" />
          <TextBlock Classes="f" Text="{Binding [Settings_UiLanguage], Source={x:Static l:Loc.Instance}}" />
          <ComboBox IsEnabled="{Binding Editable[desktop.uiLanguage]}" x:Name="UiLanguageBox" ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding UiLanguage}" />
        </StackPanel>
      </TabItem>

      <!-- Tastenkürzel (nur Windows, Phase 3) -->
      <TabItem x:Name="TabHotkeys" Header="{Binding [Settings_Hotkeys], Source={x:Static l:Loc.Instance}}" IsVisible="{Binding Hotkeys.Available}">
        <StackPanel Margin="4">
          <CheckBox x:Name="HotkeysEnabledBox" IsChecked="{Binding Hotkeys.Enabled}" Content="{Binding [Hotkey_Enabled], Source={x:Static l:Loc.Instance}}" />
          <StackPanel x:Name="HotkeyHold" DataContext="{Binding Hotkeys.Hold}" x:DataType="vm:HotkeyRowViewModel" Margin="0,8,0,0">
            <TextBlock Classes="f" Text="{Binding Label}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{StaticResource WlSurfaceHigh}" CornerRadius="4" Padding="10,4" MinWidth="180">
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
              </Border>
              <Button Content="{Binding [Hotkey_Record], Source={x:Static l:Loc.Instance}}" Command="{Binding RecordCommand}"
                      IsVisible="{Binding CanRecord}" IsEnabled="{Binding !IsRecording}" />
              <TextBlock Text="{Binding [Hotkey_Recording], Source={x:Static l:Loc.Instance}}" IsVisible="{Binding IsRecording}"
                         VerticalAlignment="Center" Foreground="{StaticResource WlAccent}" />
            </StackPanel>
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{StaticResource WlError}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel x:Name="HotkeyToggle" DataContext="{Binding Hotkeys.Toggle}" x:DataType="vm:HotkeyRowViewModel" Margin="0,8,0,0">
            <TextBlock Classes="f" Text="{Binding Label}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{StaticResource WlSurfaceHigh}" CornerRadius="4" Padding="10,4" MinWidth="180">
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
              </Border>
              <Button Content="{Binding [Hotkey_Record], Source={x:Static l:Loc.Instance}}" Command="{Binding RecordCommand}"
                      IsVisible="{Binding CanRecord}" IsEnabled="{Binding !IsRecording}" />
              <TextBlock Text="{Binding [Hotkey_Recording], Source={x:Static l:Loc.Instance}}" IsVisible="{Binding IsRecording}"
                         VerticalAlignment="Center" Foreground="{StaticResource WlAccent}" />
            </StackPanel>
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{StaticResource WlError}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel x:Name="HotkeyStage" DataContext="{Binding Hotkeys.Stage}" x:DataType="vm:HotkeyRowViewModel" Margin="0,8,0,0">
            <TextBlock Classes="f" Text="{Binding Label}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{StaticResource WlSurfaceHigh}" CornerRadius="4" Padding="10,4" MinWidth="180">
                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" />
              </Border>
              <Button Content="{Binding [Hotkey_Record], Source={x:Static l:Loc.Instance}}" Command="{Binding RecordCommand}"
                      IsVisible="{Binding CanRecord}" IsEnabled="{Binding !IsRecording}" />
              <TextBlock Text="{Binding [Hotkey_Recording], Source={x:Static l:Loc.Instance}}" IsVisible="{Binding IsRecording}"
                         VerticalAlignment="Center" Foreground="{StaticResource WlAccent}" />
            </StackPanel>
            <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="{StaticResource WlError}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <!-- Import/Export (Format v1, docs/settings-format.md) -->
      <TabItem x:Name="TabSync" Header="{Binding [Settings_Sync], Source={x:Static l:Loc.Instance}}">
        <DockPanel Margin="4" DataContext="{Binding Sync}" x:DataType="vm:SyncViewModel">
          <TextBlock DockPanel.Dock="Top" Classes="f" TextWrapping="Wrap" Text="{Binding [Sync_Hint], Source={x:Static l:Loc.Instance}}" />
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button x:Name="ExportButton" Content="{Binding [Sync_Export], Source={x:Static l:Loc.Instance}}" Click="OnExport" />
            <Button x:Name="ImportButton" Content="{Binding [Sync_Import], Source={x:Static l:Loc.Instance}}" Click="OnImport" />
            <Button x:Name="ApplyImportButton" Content="{Binding [Sync_Apply], Source={x:Static l:Loc.Instance}}" Command="{Binding ApplyCommand}" />
          </StackPanel>
          <TextBlock x:Name="SyncStatus" DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8" />
          <ListBox x:Name="SyncChanges" ItemsSource="{Binding Changes}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChangeRow">
                <TextBlock Text="{Binding Text}" FontFamily="monospace" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
