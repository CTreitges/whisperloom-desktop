<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
        xmlns:vs="using:WhisperLoom.App.Views.Settings"
        xmlns:ds="using:WhisperLoom.App.Design"
        xmlns:l="using:WhisperLoom.App.Localization"
        x:Class="WhisperLoom.App.Views.SettingsWindow"
        x:DataType="vm:SettingsShellViewModel"
        Classes="loom"
        Title="{Binding [Settings_Title], Source={x:Static l:Loc.Instance}}"
        Icon="/Assets/whisperloom.ico"
        Width="920" Height="660" MinWidth="720" MinHeight="480">
  <!--
    Hülle (UX-2, zielstruktur.md §1): links die Suche mit sichtbarer Beschriftung (D8) und die Seitenleiste – sieben Aufgaben-
    Seiten, „Firma“ abgesetzt als Konto-Eintrag (Entscheidung 17) –, rechts die Seite bzw. die Treffer der Suche. Kein
    Speichern-Knopf, jede Änderung gilt sofort. Esc leert zuerst die Suche, sonst schließt es; Strg+F springt in die Suche.
  -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:DictationPageViewModel"><vs:DictationPage /></DataTemplate>
    <DataTemplate DataType="vm:RecognitionPageViewModel"><vs:RecognitionPage /></DataTemplate>
    <DataTemplate DataType="vm:TextPageViewModel"><vs:TextPage /></DataTemplate>
    <DataTemplate DataType="vm:OutputPageViewModel"><vs:OutputPage /></DataTemplate>
    <DataTemplate DataType="vm:ConnectionsPageViewModel"><vs:ConnectionsPage /></DataTemplate>
    <DataTemplate DataType="vm:PrivacyPageViewModel"><vs:PrivacyPage /></DataTemplate>
    <DataTemplate DataType="vm:SystemPageViewModel"><vs:SystemPage /></DataTemplate>
    <DataTemplate DataType="vm:CompanyPageViewModel"><vs:CompanyPage /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="220,*" ds:Managed.Context="{Binding Managed}">
    <Border Grid.Column="0" Background="{DynamicResource Loom.Sidebar}" BorderBrush="{DynamicResource Loom.CardEdge}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,16,12,12" Spacing="{DynamicResource Loom.Space.1}">
          <TextBlock x:Name="SearchLabel" Text="{Binding [Search_Name], Source={x:Static l:Loc.Instance}}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}"
                   AutomationProperties.Name="{Binding [Search_Name], Source={x:Static l:Loc.Instance}}"
                   AutomationProperties.HelpText="{Binding [Search_Help], Source={x:Static l:Loc.Instance}}">
            <TextBox.InnerLeftContent>
              <ds:LoomIcon Data="{DynamicResource Loom.Icon.Search}" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource Loom.TextSecondary}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button x:Name="ClearSearchButton" Classes="flat" Width="24" Height="24" Padding="0" Margin="0,0,4,0" IsVisible="{Binding IsSearching}"
                      Click="OnClearSearch" AutomationProperties.Name="{Binding [Search_Clear], Source={x:Static l:Loc.Instance}}"
                      ToolTip.Tip="{Binding [Search_Clear], Source={x:Static l:Loc.Instance}}">
                <ds:LoomIcon Data="{DynamicResource Loom.Icon.Close}" Width="16" Height="16" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </StackPanel>

        <ListBox x:Name="PageList" Classes="sidebar" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                 AutomationProperties.Name="{Binding [Sidebar_Name], Source={x:Static l:Loc.Instance}}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:SettingsPageViewModel">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsPageViewModel">
              <StackPanel>
                <!-- Konto-Eintrag: abgesetzt durch Abstand und Linie. -->
                <Border Classes="accountGap" IsVisible="{Binding IsAccount}" />
                <Border Classes="sideItem">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Loom.Space.3}">
                    <ds:LoomIcon Data="{Binding Icon, Converter={x:Static ds:ResourceKeyConverter.Instance}}" Width="20" Height="20" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- PERF-2: Inhalt = SelectedPage (Code-Behind, einen Durchlauf nach der Markierung), Vorlage = PageViewCache. -->
    <!-- Vorbau (PERF-2): Seiten hängen hier nur kurz (wenige Dispatcher-Durchläufe), unsichtbar, ohne Treffer und Tab-Stopps. -->
    <!-- W3-PERF N7: StagingPanel hält die Seiten auch aus dem Automation-Baum (UIA, AT-SPI) fern. -->
    <vs:StagingPanel x:Name="Staging" Grid.Column="1" IsHitTestVisible="False" Opacity="0" KeyboardNavigation.TabNavigation="None" />
    <ContentControl x:Name="PageHost" Grid.Column="1" IsVisible="{Binding !IsSearching}" />

    <!-- Treffer der Suche im Inhaltsbereich: Titel, darunter „Seite › Gruppe“; Auswahl springt zur Zeile und markiert sie kurz. -->
    <ScrollViewer x:Name="SearchPage" Grid.Column="1" IsVisible="{Binding IsSearching}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,32" Spacing="{DynamicResource Loom.Space.4}" MaxWidth="760">
        <TextBlock Text="{Binding [Search_Title], Source={x:Static l:Loc.Instance}}" Margin="17,0,0,0" FontSize="{DynamicResource Loom.Font.PageTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
        <TextBlock x:Name="NoResults" Text="{Binding ResultSummary}" Margin="17,0,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Loom.TextSecondary}" AutomationProperties.LiveSetting="Polite" />
        <Border Classes="card" IsVisible="{Binding Results.Count}">
          <!-- Treffer sind Sprungziele (Knöpfe): Tab bzw. ↓/↑ wandert, Enter oder Klick springt zur Zeile. -->
          <ItemsControl x:Name="ResultList" ItemsSource="{Binding Results}"
                        AutomationProperties.Name="{Binding [Search_Results], Source={x:Static l:Loc.Instance}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchResult">
                <Button Classes="result" Command="{Binding $parent[Window].((vm:SettingsShellViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Location}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Location}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <ds:LoomIcon Grid.Column="1" Data="{DynamicResource Loom.Icon.Forward}" Width="16" Height="16" Margin="12,0,0,0"
                                 Foreground="{DynamicResource Loom.TextSecondary}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
