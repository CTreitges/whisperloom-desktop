<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WhisperLoom.App.ViewModels"
        xmlns:l="using:WhisperLoom.App.Localization"
        x:Class="WhisperLoom.App.Views.StageWindow"
        x:DataType="vm:StageViewModel"
        Title="{Binding [Stage_Title], Source={x:Static l:Loc.Instance}}"
        Icon="/Assets/whisperloom.ico"
        Width="1200" Height="700" MinWidth="640" MinHeight="400"
        Background="{StaticResource WlBackground}">
  <!-- Bühnenansicht für Beamer: Farben aus der Android-UX-Spec v3 §3.1 (ux-spec-v3.md). -->
  <Window.Styles>
    <Style Selector="Ellipse#RecordDot">
      <Setter Property="Fill" Value="{StaticResource WlSurfaceHigh}" />
    </Style>
    <Style Selector="Ellipse#RecordDot.recording">
      <Setter Property="Fill" Value="{StaticResource WlRecording}" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource WlOnSurfaceVariant}" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="18" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24">
    <!-- Kopf: Indikator, Timer, Pegel, Steuerung, Stufe, Sprache -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,20">
      <Ellipse x:Name="RecordDot" Grid.Column="0" Width="72" Height="72"
               Classes.recording="{Binding IsRecording}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center" Spacing="4">
        <TextBlock x:Name="Timer" Text="{Binding ElapsedText}" FontSize="44" FontWeight="Bold"
                   Foreground="{StaticResource WlOnSurface}" FontFamily="monospace" />
        <TextBlock x:Name="StateLabel" Text="{Binding StateText}" Classes="label" />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10" Margin="12,0">
        <ProgressBar x:Name="LevelBar" Value="{Binding Level}" Minimum="0" Maximum="1" Height="14"
                     Foreground="{StaticResource WlAccent}" Background="{StaticResource WlSurfaceHigh}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="ToggleButton" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" />
          <Button x:Name="PauseButton" Content="{Binding PauseText}" Command="{Binding PauseResumeCommand}"
                  IsEnabled="{Binding IsRecording}" />
          <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource WlError}" FontSize="18"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
        <Button x:Name="StageButton" Command="{Binding NextStageCommand}" HorizontalAlignment="Right"
                Background="{StaticResource WlTertiaryContainer}">
          <TextBlock FontSize="22" Foreground="{StaticResource WlOnTertiaryContainer}">
            <Run Text="{Binding [Stage_Label], Source={x:Static l:Loc.Instance}}" />
            <Run Text=": " />
            <Run x:Name="StageRun" Text="{Binding StageText}" FontWeight="Bold" />
          </TextBlock>
        </Button>
        <TextBlock HorizontalAlignment="Right" FontSize="22" Foreground="{StaticResource WlSecondary}">
          <Run Text="{Binding [Language_Label], Source={x:Static l:Loc.Instance}}" />
          <Run Text=": " />
          <Run x:Name="LanguageRun" Text="{Binding LanguageText}" FontWeight="Bold" />
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Links Rohtext, rechts Ergebnis -->
    <Grid x:Name="Panels" Grid.Row="1" ColumnDefinitions="*,24,*">
      <Border Grid.Column="0" Background="{StaticResource WlSurface}" CornerRadius="20" Padding="20">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="CopyRawButton" DockPanel.Dock="Right" Click="OnCopyRaw"
                    Content="{Binding [Action_Copy], Source={x:Static l:Loc.Instance}}" />
            <TextBlock Text="{Binding [Stage_Raw], Source={x:Static l:Loc.Instance}}" Classes="label"
                       VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer>
            <SelectableTextBlock x:Name="RawText" Text="{Binding RawText}" FontSize="{Binding FontSize}"
                                 TextWrapping="Wrap" Foreground="{StaticResource WlOnSurfaceVariant}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource WlSurface}" CornerRadius="20" Padding="20"
              BorderBrush="{StaticResource WlAccent}" BorderThickness="2">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="CopyResultButton" DockPanel.Dock="Right" Click="OnCopyResult"
                    Content="{Binding [Action_Copy], Source={x:Static l:Loc.Instance}}" />
            <TextBlock Text="{Binding [Stage_Result], Source={x:Static l:Loc.Instance}}" Classes="label"
                       VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer>
            <SelectableTextBlock x:Name="ResultText" Text="{Binding ResultText}" FontSize="{Binding FontSize}"
                                 TextWrapping="Wrap" Foreground="{StaticResource WlOnSurface}" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
