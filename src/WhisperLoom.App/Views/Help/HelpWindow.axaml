<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="using:WhisperLoom.App.Views.Help"
        xmlns:ds="using:WhisperLoom.App.Design"
        xmlns:l="using:WhisperLoom.App.Localization"
        x:Class="WhisperLoom.App.Views.Help.HelpWindow"
        x:DataType="h:HelpViewModel"
        Classes="loom"
        Title="{Binding [Help_WindowTitle], Source={x:Static l:Loc.Instance}}"
        Icon="/Assets/whisperloom.ico"
        Width="1000" Height="720" MinWidth="720" MinHeight="480">
  <!--
    Hilfe (UX-3, mockups/hilfe.html): links „Hilfe durchsuchen“ mit Beschriftung und die Themen in vier Gruppen (Loom-Symbole in
    Textfarbe), rechts der Abschnitt mit einer Textkante (Rand 24 + 17 = x 41): Titel, Einleitung mit Illustration rechts,
    Zwischenüberschriften (Ebene 2), Aufzählungen mit hängendem Punkt, Screenshots als Karten mit Ziffern-Legende und „Mehr dazu“-
    Links ≥ 24 px. Die Übersicht fragt „Was willst du tun?“; Treffer der Suche stehen rechts mit Gruppe und Fundstelle.
    Strg+F = Suche, ↓ aus der Suche in die Treffer, Esc leert die Suche bzw. schließt.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="{DynamicResource Loom.Font.Body}" />
      <Setter Property="Foreground" Value="{DynamicResource Loom.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{DynamicResource Loom.Font.Title}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Loom.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="17,8,0,0" />
      <Setter Property="AutomationProperties.HeadingLevel" Value="2" />
    </Style>
    <Style Selector="Border.number">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource Loom.Accent}" />
    </Style>
    <Style Selector="Border.number TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Loom.OnAccent}" />
      <Setter Property="FontSize" Value="{DynamicResource Loom.Font.Caption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.helpLink">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Loom.Accent}" />
    </Style>
    <Style Selector="Button.helpLink /template/ ContentPresenter#PART_ContentPresenter, Button.helpLink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Loom.Accent}" />
    </Style>
    <Style Selector="Button.helpLink:pointerover TextBlock.label">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="264,*">
    <!-- Seitenleiste: Suche und Themen -->
    <Border Grid.Column="0" Background="{DynamicResource Loom.Sidebar}" BorderBrush="{DynamicResource Loom.CardEdge}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,16,12,12" Spacing="{DynamicResource Loom.Space.1}">
          <TextBlock x:Name="SearchLabel" Text="{Binding [Help_SearchName], Source={x:Static l:Loc.Instance}}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}"
                   AutomationProperties.Name="{Binding [Help_SearchName], Source={x:Static l:Loc.Instance}}"
                   AutomationProperties.HelpText="{Binding [Help_SearchHelp], Source={x:Static l:Loc.Instance}}">
            <TextBox.InnerLeftContent>
              <ds:LoomIcon Data="{DynamicResource Loom.Icon.Search}" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource Loom.TextSecondary}" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button x:Name="ClearSearchButton" Classes="flat" Width="24" Height="24" Padding="0" Margin="0,0,4,0" Click="OnClearSearch"
                      IsVisible="{Binding IsSearching}"
                      AutomationProperties.Name="{Binding [Search_Clear], Source={x:Static l:Loc.Instance}}"
                      ToolTip.Tip="{Binding [Search_Clear], Source={x:Static l:Loc.Instance}}">
                <ds:LoomIcon Data="{DynamicResource Loom.Icon.Close}" Width="16" Height="16" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
        </StackPanel>

        <ListBox x:Name="SectionList" Classes="sidebar" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 AutomationProperties.Name="{Binding [Help_SidebarName], Source={x:Static l:Loc.Instance}}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="h:HelpSectionViewModel">
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="h:HelpSectionViewModel">
              <StackPanel>
                <TextBlock Classes="section" Text="{Binding GroupTitle}" IsVisible="{Binding GroupTitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Border Classes="sideItem">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Loom.Space.3}">
                    <ds:LoomIcon Data="{Binding IconGeometry}" Width="20" Height="20" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="ContentScroll" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Focusable="True"
                  Background="{DynamicResource Loom.Background}">
      <Panel Margin="24,20,24,32" MaxWidth="760" HorizontalAlignment="Left">
        <!-- Treffer der Suche: Titel und Gruppe, darunter die Fundstelle; Auswahl öffnet den Abschnitt. -->
        <StackPanel x:Name="SearchPage" Spacing="{DynamicResource Loom.Space.4}" IsVisible="{Binding IsSearching}">
          <TextBlock Text="{Binding [Help_SearchTitle], Source={x:Static l:Loc.Instance}}" Margin="17,0,0,0" FontSize="{DynamicResource Loom.Font.WindowTitle}"
                     FontWeight="SemiBold" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />
          <TextBlock x:Name="NoResults" Text="{Binding SearchSummary}" Margin="17,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Loom.TextSecondary}"
                     AutomationProperties.LiveSetting="Polite" />
          <Border Classes="card" IsVisible="{Binding Results.Count}">
            <ItemsControl x:Name="ResultList" ItemsSource="{Binding Results}"
                          AutomationProperties.Name="{Binding [Search_Results], Source={x:Static l:Loc.Instance}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:HelpSearchResult">
                  <Button Classes="result" Click="OnResultClick" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Snippet}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <WrapPanel ItemSpacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Group}" Classes="caption" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Snippet}" Classes="caption" TextWrapping="Wrap" />
                      </StackPanel>
                      <ds:LoomIcon Grid.Column="1" Data="{DynamicResource Loom.Icon.Forward}" Width="16" Height="16" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Loom.TextSecondary}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <StackPanel x:Name="SectionContent" DataContext="{Binding SelectedSection}" x:DataType="h:HelpSectionViewModel"
                    Spacing="{DynamicResource Loom.Space.4}" IsVisible="{Binding $parent[Window].((h:HelpViewModel)DataContext).ShowSection, FallbackValue=True}">
          <TextBlock x:Name="SectionTitle" Text="{Binding Title}" Margin="17,0,0,0" FontSize="{DynamicResource Loom.Font.WindowTitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="1" />

          <!-- Übersicht: Einleitung und „Was willst du tun?“ -->
          <StackPanel IsVisible="{Binding IsOverview}" Spacing="{DynamicResource Loom.Space.4}">
            <TextBlock Classes="body" Text="{Binding Intro}" Margin="17,0,0,0" />
            <TextBlock Classes="heading" Text="{Binding [Help_TasksTitle], Source={x:Static l:Loc.Instance}}" />
            <Border Classes="card">
              <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}"
                            AutomationProperties.Name="{Binding [Help_TasksTitle], Source={x:Static l:Loc.Instance}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="h:HelpTaskView">
                    <Button Classes="result" Click="OnTaskClick" AutomationProperties.Name="{Binding Text}" AutomationProperties.HelpText="{Binding SectionTitle}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SectionTitle}" Classes="caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <ds:LoomIcon Grid.Column="1" Data="{DynamicResource Loom.Icon.Forward}" Width="16" Height="16" Margin="12,0,0,0"
                                     Foreground="{DynamicResource Loom.TextSecondary}" VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- Abschnitt: Einleitung mit Illustration rechts, Text, Screenshots, Links. -->
          <StackPanel IsVisible="{Binding !IsOverview}" Spacing="{DynamicResource Loom.Space.4}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="body" Text="{Binding Intro}" Margin="17,0,0,0" VerticalAlignment="Center" />
              <h:HelpIllustration x:Name="Illustration" Grid.Column="1" Width="192" Height="144" Margin="16,0,0,0" Source="{Binding Illustration}"
                                  VerticalAlignment="Top" AutomationProperties.Name="{Binding ImageAlt}" ToolTip.Tip="{Binding ImageAlt}" />
            </Grid>

            <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:HelpLine">
                  <Panel Margin="0,0,0,8">
                    <TextBlock Classes="heading" Text="{Binding Text}" IsVisible="{Binding IsHeading}" />
                    <!-- Aufzählung: Punkt hängt vor der Kante, der Text steht auf ihr. -->
                    <Grid ColumnDefinitions="17,*" IsVisible="{Binding IsBullet}">
                      <Ellipse Width="5" Height="5" Fill="{DynamicResource Loom.Accent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />
                      <TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" />
                    </Grid>
                    <TextBlock Classes="body" Text="{Binding Text}" Margin="17,0,0,0" IsVisible="{Binding IsParagraph}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl x:Name="Shots" ItemsSource="{Binding Shots}" IsVisible="{Binding HasShots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="h:HelpShotView">
                  <Border Classes="card" Padding="16" Margin="0,0,0,16">
                    <StackPanel Spacing="{DynamicResource Loom.Space.3}">
                      <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Loom.Text}" />
                      <h:HelpScreenshot Shot="{Binding Shot.Name}" Stretch="Uniform" HorizontalAlignment="Left"
                                        AutomationProperties.Name="{Binding Caption}" />
                      <ItemsControl ItemsSource="{Binding Legend}" AutomationProperties.Name="{Binding [Help_Legend], Source={x:Static l:Loc.Instance}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="h:HelpLegend">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                              <Border Classes="number" VerticalAlignment="Top"><TextBlock Text="{Binding Number}" /></Border>
                              <TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" Margin="10,1,0,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasLinks}" Spacing="{DynamicResource Loom.Space.2}">
              <TextBlock Classes="heading" Text="{Binding [Help_More], Source={x:Static l:Loc.Instance}}" />
              <ItemsControl x:Name="Links" ItemsSource="{Binding Links}" Margin="17,0,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="h:HelpLinkView">
                    <Button Classes="helpLink" Click="OnLinkClick" HorizontalAlignment="Left" ToolTip.Tip="{Binding Url}"
                            AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding [Help_OpensBrowser], Source={x:Static l:Loc.Instance}}">
                      <WrapPanel ItemSpacing="6">
                        <ds:LoomIcon Data="{DynamicResource Loom.Icon.External}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Loom.Accent}" />
                        <TextBlock Classes="label" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding [Help_OpensBrowser], Source={x:Static l:Loc.Instance}}" Classes="caption" VerticalAlignment="Center" />
                      </WrapPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </Grid>
</Window>
