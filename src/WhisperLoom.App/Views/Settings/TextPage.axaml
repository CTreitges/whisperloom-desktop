<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
             xmlns:v="using:WhisperLoom.App.Views"
             xmlns:ds="using:WhisperLoom.App.Design"
             xmlns:l="using:WhisperLoom.App.Localization"
             xmlns:vs="using:WhisperLoom.App.Views.Settings"
             x:Class="WhisperLoom.App.Views.Settings.TextPage"
             x:DataType="vm:TextPageViewModel">
  <ds:SettingsPage TitleKey="Page_text">
    <StackPanel Spacing="20">
      <ds:SettingsGroup TitleKey="G_StageChoice">
        <StackPanel>
          <ds:SettingRow Path="refine.stage">
            <ComboBox x:Name="StageBox" Classes="row" ItemsSource="{Binding Session.Stages}" SelectedItem="{Binding Session.Stage}" />
          </ds:SettingRow>
          <ds:SettingRow Path="refine.promptEnabled">
            <ToggleSwitch IsChecked="{Binding Session.PromptEnabled}" OnContent="" OffContent="" />
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>

      <ds:SettingsGroup TitleKey="G_StageOptions">
        <StackPanel>
          <ds:SettingRow Path="refine.polishCleanup">
            <ComboBox Classes="row" ItemsSource="{Binding CleanupChoices}" SelectedItem="{Binding PolishCleanup}" />
          </ds:SettingRow>
          <ds:SettingRow Path="refine.paragraphsPolish">
            <ToggleSwitch IsChecked="{Binding ParagraphsPolish}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <ds:SettingRow Path="refine.paragraphsBeautify">
            <ToggleSwitch IsChecked="{Binding ParagraphsBeautify}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <ds:SettingRow Path="refine.summarizeForm">
            <ComboBox Classes="row" ItemsSource="{Binding FormChoices}" SelectedItem="{Binding SummarizeForm}" />
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>

      <ds:SettingsGroup TitleKey="G_Llm">
        <StackPanel>
          <ds:SettingRow Path="llm.providerId">
            <ComboBox x:Name="LlmProviderBox" Classes="row" ItemsSource="{Binding Session.LlmProviders}" SelectedItem="{Binding Session.LlmProvider}" />
          </ds:SettingRow>
          <Panel IsVisible="{Binding !Session.LlmUsesEntry}">
            <ds:SettingRow Path="secrets.llm" Stacked="True">
              <v:KeyFieldView x:Name="LlmKeyView" DataContext="{Binding Session.LlmKey}" />
            </ds:SettingRow>
          </Panel>
          <ds:HintRow TextKey="Key_AtEntry" IsVisible="{Binding Session.LlmUsesEntry}" Margin="14,4,14,10" />
          <ds:SettingRow Path="llm.model">
            <vs:ModelPickerView x:Name="LlmModelPicker" DataContext="{Binding LlmModelPicker}" />
          </ds:SettingRow>
          <Expander Classes="advanced" IsExpanded="{Binding AdvancedOpen}" Header="{Binding [Advanced], Source={x:Static l:Loc.Instance}}">
            <StackPanel>
              <ds:SettingRow Path="llm.baseUrl" Error="{Binding Session.Errors[llm.baseUrl]}">
                <TextBox Classes="row" Text="{Binding Session.LlmBaseUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="https://…/v1" />
              </ds:SettingRow>
              <ds:SettingRow Path="llm.stageModels.polish">
                <ds:CustomChoiceBox DataContext="{Binding StagePolish}" />
              </ds:SettingRow>
              <ds:SettingRow Path="llm.stageModels.beautify">
                <ds:CustomChoiceBox DataContext="{Binding StageBeautify}" />
              </ds:SettingRow>
              <ds:SettingRow Path="llm.stageModels.summarize">
                <ds:CustomChoiceBox DataContext="{Binding StageSummarize}" />
              </ds:SettingRow>
              <ds:SettingRow Path="llm.stageModels.prompt">
                <ds:CustomChoiceBox DataContext="{Binding StagePrompt}" />
              </ds:SettingRow>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ds:SettingsGroup>

      <ds:SettingsGroup TitleKey="G_LocalText">
        <StackPanel>
          <ds:SettingRow Path="offline.refine">
            <ComboBox Classes="row" ItemsSource="{Binding Local.Rules}" SelectedItem="{Binding Local.Rule}" />
          </ds:SettingRow>
          <ds:SettingRow Path="local.textEngine">
            <ComboBox x:Name="TextEngineBox" Classes="row" ItemsSource="{Binding Local.TextEngines}" SelectedItem="{Binding Local.TextEngine}" />
          </ds:SettingRow>
          <StackPanel IsVisible="{Binding Local.IsBundled}">
            <ds:SettingRow Path="local.bundledModel">
              <ComboBox x:Name="BundledModelBox" Classes="row" ItemsSource="{Binding Local.BundledModels}" SelectedItem="{Binding Local.BundledModel}" />
            </ds:SettingRow>
            <ds:HintRow TextKey="Local_BundledHint" Margin="14,4,14,10" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Local.IsServer}">
            <ds:SettingRow Path="local.textServer">
              <ComboBox x:Name="TextServerBox" Classes="row" ItemsSource="{Binding Local.TextServers}" SelectedItem="{Binding Local.TextServer}" />
            </ds:SettingRow>
            <ds:HintRow TextKey="Local_ServerHint" Margin="14,4,14,10" />
          </StackPanel>
          <StackPanel IsVisible="{Binding Local.IsOllama}">
          <ds:SettingRow Path="local.ollamaModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox x:Name="OllamaBox" MinWidth="180" ItemsSource="{Binding Local.OllamaModels}" SelectedItem="{Binding Local.OllamaModel}" />
              <Button Content="{Binding [Local_OllamaRefresh], Source={x:Static l:Loc.Instance}}" Command="{Binding Local.RefreshOllamaCommand}" />
            </StackPanel>
          </ds:SettingRow>
          <ds:HintRow x:Name="OllamaStatusText" Text="{Binding Local.OllamaStatus}" IsVisible="{Binding Local.OllamaStatus.Length}" Margin="14,0,14,10" />
          <SelectableTextBlock x:Name="OllamaLink" IsVisible="{Binding Local.OllamaMissing}" Text="{Binding Local.OllamaDownloadUrl}"
                               Foreground="{DynamicResource Loom.Accent}" Margin="14,0,14,10" />
          </StackPanel>
          <Expander Classes="advanced" Header="{Binding [Advanced], Source={x:Static l:Loc.Instance}}">
            <StackPanel>
              <ds:SettingRow Path="local.ollamaUrl" Error="{Binding Session.Errors[local.ollamaUrl]}">
                <TextBox Classes="row" Text="{Binding OllamaUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="http://127.0.0.1:11434" />
              </ds:SettingRow>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ds:SettingsGroup>

      <ds:SettingsGroup TitleKey="G_Fallback">
        <StackPanel>
          <ds:SettingRow Path="llmFallback.enabled">
            <ToggleSwitch IsChecked="{Binding Session.LlmFallbackEnabled}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <StackPanel IsEnabled="{Binding Session.LlmFallbackEnabled}">
            <ds:SettingRow Path="llmFallback.providerId">
              <ComboBox Classes="row" ItemsSource="{Binding Session.LlmFallbackProviders}" SelectedItem="{Binding Session.LlmFallbackProvider}" />
            </ds:SettingRow>
            <Panel IsVisible="{Binding !Session.LlmFallbackUsesEntry}">
              <ds:SettingRow Path="secrets.llmFallback" Stacked="True">
                <v:KeyFieldView x:Name="LlmFallbackKeyView" DataContext="{Binding Session.LlmFallbackKey}" />
              </ds:SettingRow>
            </Panel>
            <ds:HintRow TextKey="Key_AtEntry" IsVisible="{Binding Session.LlmFallbackUsesEntry}" Margin="14,4,14,10" />
            <ds:SettingRow Path="llmFallback.model">
              <vs:ModelPickerView DataContext="{Binding LlmFallbackModelPicker}" />
            </ds:SettingRow>
            <Expander Classes="advanced" IsExpanded="{Binding FallbackAdvancedOpen}" Header="{Binding [Advanced], Source={x:Static l:Loc.Instance}}">
              <StackPanel>
                <ds:SettingRow Path="llmFallback.baseUrl" Error="{Binding Session.Errors[llmFallback.baseUrl]}">
                  <TextBox Classes="row" Text="{Binding Session.LlmFallbackBaseUrl, UpdateSourceTrigger=LostFocus}" PlaceholderText="https://…/v1" />
                </ds:SettingRow>
              </StackPanel>
            </Expander>
          </StackPanel>
        </StackPanel>
      </ds:SettingsGroup>
    </StackPanel>
  </ds:SettingsPage>
</UserControl>
