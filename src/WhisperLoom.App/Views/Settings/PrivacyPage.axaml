<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
             xmlns:ds="using:WhisperLoom.App.Design"
             xmlns:l="using:WhisperLoom.App.Localization"
             x:Class="WhisperLoom.App.Views.Settings.PrivacyPage"
             x:DataType="vm:PrivacyPageViewModel">
  <ds:SettingsPage TitleKey="Page_privacy" IntroKey="PageIntro_privacy">
    <StackPanel Spacing="{DynamicResource Loom.Space.5}">
      <ds:SettingsGroup TitleKey="G_History" FooterKey="Settings_PrivacyNote">
        <StackPanel>
          <ds:SettingRow Path="history.enabled">
            <ToggleSwitch x:Name="HistoryToggle" IsChecked="{Binding Session.HistoryEnabled}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <ds:SettingRow x:Name="HistoryConfirm" TitleKey="History_OffConfirm" DescriptionKey="History_OffConfirm_Desc"
                         IsVisible="{Binding Session.HistoryOffPending}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding [Action_Cancel], Source={x:Static l:Loc.Instance}}" Command="{Binding Session.CancelHistoryOffCommand}" />
              <Button x:Name="HistoryOffButton" Content="{Binding [History_OffAction], Source={x:Static l:Loc.Instance}}"
                      Command="{Binding Session.ConfirmHistoryOffCommand}" Foreground="{DynamicResource Loom.Error}" />
            </StackPanel>
          </ds:SettingRow>
          <ds:SettingRow Path="history.size">
            <ds:OptionGroup x:Name="HistorySizeBox" ItemsSource="{Binding Session.HistorySizeOptions}" SelectedItem="{Binding Session.HistorySizeOption}" />
          </ds:SettingRow>
          <ds:SettingRow x:Name="HistoryShrinkConfirm" TitleKey="History_ShrinkConfirm" IsVisible="{Binding Session.HistoryShrinkPending}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Session.HistoryShrinkText}" Foreground="{DynamicResource Loom.TextSecondary}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding [Action_Cancel], Source={x:Static l:Loc.Instance}}" Command="{Binding Session.CancelHistoryShrinkCommand}" />
                <Button x:Name="HistoryShrinkButton" Content="{Binding [History_ShrinkAction], Source={x:Static l:Loc.Instance}}"
                        Command="{Binding Session.ConfirmHistoryShrinkCommand}" Foreground="{DynamicResource Loom.Error}" />
              </StackPanel>
            </StackPanel>
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>

      <ds:SettingsGroup TitleKey="G_Keys">
        <StackPanel>
          <ds:SettingRow TitleKey="Settings_KeyStore" DescriptionKey="Set_KeyStore_Desc">
            <TextBlock x:Name="SecretStoreKindText" Text="{Binding Session.SecretStoreKind}" Foreground="{DynamicResource Loom.TextSecondary}" />
          </ds:SettingRow>
          <ds:HintRow x:Name="SecretFileHint" Kind="Warning" TextKey="Settings_KeyFileHint" IsVisible="{Binding Session.SecretStoreIsFile}" Margin="16,0,16,12" />
        </StackPanel>
      </ds:SettingsGroup>
    </StackPanel>
  </ds:SettingsPage>
</UserControl>
