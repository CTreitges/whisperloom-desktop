<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
             xmlns:ds="using:WhisperLoom.App.Design"
             x:Class="WhisperLoom.App.Views.Settings.CleanupPage"
             x:DataType="vm:CleanupPageViewModel">
  <ds:SettingsPage TitleKey="Page_cleanup">
    <StackPanel Spacing="20">
      <ds:HintRow TextKey="Cleanup_Intro" />
      <ds:SettingsGroup TitleKey="G_Auto">
        <StackPanel>
          <ds:SettingRow Path="polish.removeFillers">
            <ToggleSwitch IsChecked="{Binding RemoveFillers}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <ds:SettingRow Path="polish.autoCapitalize">
            <ToggleSwitch IsChecked="{Binding AutoCapitalize}" OnContent="" OffContent="" />
          </ds:SettingRow>
          <ds:SettingRow Path="polish.trailingSpace">
            <ToggleSwitch IsChecked="{Binding TrailingSpace}" OnContent="" OffContent="" />
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>
      <ds:SettingsGroup TitleKey="G_Fillers">
        <StackPanel IsEnabled="{Binding RemoveFillers}">
          <ds:SettingRow Path="polish.customFillers" Stacked="True">
            <TextBox Classes="wide" Text="{Binding CustomFillers, UpdateSourceTrigger=LostFocus}" PlaceholderText="äh, ähm, hm" />
          </ds:SettingRow>
          <ds:SettingRow Path="polish.disabledFillers" Stacked="True">
            <TextBox Classes="wide" Text="{Binding DisabledFillers, UpdateSourceTrigger=LostFocus}" />
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>
    </StackPanel>
  </ds:SettingsPage>
</UserControl>
