<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhisperLoom.App.ViewModels.Settings"
             xmlns:ds="using:WhisperLoom.App.Design"
             xmlns:s="using:WhisperLoom.App.Setup"
             xmlns:l="using:WhisperLoom.App.Localization"
             x:Class="WhisperLoom.App.Views.Settings.CompanyPage"
             x:DataType="vm:CompanyPageViewModel">
  <!-- Seite „Firma“ (W2-ENR). Verlassen ist zerstörend für die Anbindung: Rückfrage inline (HIG „Alerts“: nur wo nötig). -->
  <ds:SettingsPage TitleKey="Page_company" IntroKey="PageIntro_company">
    <StackPanel Spacing="{DynamicResource Loom.Space.5}">
      <!-- Verbunden -->
      <ds:SettingsGroup TitleKey="G_Company" IsVisible="{Binding IsConnected}">
        <StackPanel>
          <ds:HintRow x:Name="CompanyNotice" Kind="Warning" Text="{Binding Notice}" IsVisible="{Binding Notice.Length}" Margin="16,12,16,4" />
          <ds:SettingRow TitleKey="Company_Name">
            <TextBlock x:Name="CompanyName" Text="{Binding TenantName}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_Server">
            <SelectableTextBlock x:Name="CompanyServer" Text="{Binding ServerUrl}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_Status" DescriptionKey="Company_StatusDesc">
            <TextBlock x:Name="CompanyState" Text="{Binding StateText}" VerticalAlignment="Center" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_LastSync">
            <TextBlock x:Name="CompanyLastSync" Text="{Binding LastSyncText}" VerticalAlignment="Center" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_Device">
            <SelectableTextBlock x:Name="CompanyDevice" Text="{Binding DeviceId}" FontFamily="monospace" VerticalAlignment="Center" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_SyncNow" DescriptionKey="Company_SyncNowDesc">
            <Button x:Name="SyncNowButton" Content="{Binding [Company_SyncNowButton], Source={x:Static l:Loc.Instance}}" Command="{Binding SyncNowCommand}" />
          </ds:SettingRow>
          <ds:SettingRow TitleKey="Company_Leave" DescriptionKey="Company_LeaveDesc" IsVisible="{Binding CanLeave}">
            <Button x:Name="LeaveButton" Content="{Binding [Company_LeaveButton], Source={x:Static l:Loc.Instance}}" Command="{Binding LeaveCommand}" />
          </ds:SettingRow>
          <StackPanel x:Name="LeaveConfirm" IsVisible="{Binding LeavePending}" Spacing="8" Margin="16,4,16,12">
            <ds:HintRow Kind="Warning" TextKey="Company_LeaveConfirm" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CancelLeaveButton" Content="{Binding [Action_Cancel], Source={x:Static l:Loc.Instance}}" Command="{Binding CancelLeaveCommand}" />
              <Button x:Name="ConfirmLeaveButton" Content="{Binding [Company_LeaveConfirmButton], Source={x:Static l:Loc.Instance}}" Command="{Binding ConfirmLeaveCommand}" />
            </StackPanel>
          </StackPanel>
          <ds:HintRow x:Name="CompanyLeaveLocked" TextKey="Company_LeaveLocked" IsVisible="{Binding !CanLeave}" Margin="16,4,16,12" />
        </StackPanel>
      </ds:SettingsGroup>

      <!-- Nicht verbunden: „Mit Firma verbinden …“ -->
      <ds:SettingsGroup TitleKey="G_CompanyConnect" FooterKey="Company_ConnectFooter" IsVisible="{Binding ShowConnect}">
        <StackPanel>
          <ds:HintRow x:Name="CompanyRevoked" Kind="Warning" Text="{Binding Notice}" IsVisible="{Binding Notice.Length}" Margin="16,12,16,4" />
          <ds:SettingRow TitleKey="Company_Connect" DescriptionKey="Company_ConnectDesc" IsVisible="{Binding !ShowJoin}">
            <Button x:Name="ConnectButton" Content="{Binding [Company_ConnectButton], Source={x:Static l:Loc.Instance}}" Command="{Binding OpenJoinCommand}" />
          </ds:SettingRow>
        </StackPanel>
      </ds:SettingsGroup>

      <!-- Formular wie im Assistenten -->
      <ds:SettingsGroup TitleKey="G_CompanyJoin" FooterKey="Company_ConnectFooter" IsVisible="{Binding ShowJoin}">
        <StackPanel Margin="16,12,16,16" Spacing="{DynamicResource Loom.Space.3}">
          <!-- UX-3: dieselbe Beitritts-Ansicht wie im Assistenten (Beschriftung, Hinweis mit Beispiel, keine Platzhalter). -->
          <s:CompanyJoinView x:Name="JoinView" DataContext="{Binding Join}" />
          <Button x:Name="CloseJoinButton" Classes="text" HorizontalAlignment="Left" Content="{Binding [Action_Cancel], Source={x:Static l:Loc.Instance}}"
                  Command="{Binding CloseJoinCommand}" IsVisible="{Binding Join.ShowInput, FallbackValue=False}" />
        </StackPanel>
      </ds:SettingsGroup>

      <ds:HintRow x:Name="CompanyStatusText" Text="{Binding Status}" IsVisible="{Binding Status.Length}" />
    </StackPanel>
  </ds:SettingsPage>
</UserControl>
