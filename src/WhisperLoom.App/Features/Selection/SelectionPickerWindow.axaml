<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:WhisperLoom.App.Localization"
        xmlns:ds="using:WhisperLoom.App.Design"
        x:Class="WhisperLoom.App.Features.Selection.SelectionPickerWindow"
        x:DataType="ds:StagePickerViewModel"
        Title="{Binding [Selection_PickerTitle], Source={x:Static l:Loc.Instance}}"
        Width="336" SizeToContent="Height"
        FontSize="{DynamicResource Loom.Font.Body}"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- Stufen-Wähler am Cursor (W2-SEL, markierung.html): unter Windows fokusfrei (NoActivate), Tasten kommen über den Hook; unter
       Linux ein normales kleines Fenster. Folgt dem Systemthema. Titel-Symbol, Ziffern und Tastenkappen am Innenrand (16),
       Titel und Zeilentext in derselben Spalte (Befund 5). -->
  <Border Classes="float" Padding="6">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="24,*" Margin="10,8,10,2">
        <ds:LoomIcon Data="{DynamicResource Loom.Icon.Selection}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Foreground="{DynamicResource Loom.Accent}" />
        <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding [Selection_PickerTitle], Source={x:Static l:Loc.Instance}}"
                   FontSize="{DynamicResource Loom.Font.Title}" FontWeight="SemiBold" Foreground="{DynamicResource Loom.Text}" TextWrapping="Wrap" />
      </Grid>
      <ds:StagePicker x:Name="PickerView" AutomationProperties.Name="{Binding [Stage_Label], Source={x:Static l:Loc.Instance}}"
                      AutomationProperties.ControlTypeOverride="List" />
      <ds:KeycapText x:Name="KeysText" Margin="10,2,10,8" FontSize="{DynamicResource Loom.Font.Caption}" Foreground="{DynamicResource Loom.TextSecondary}"
                     Template="{Binding [Selection_PickerKeys], Source={x:Static l:Loc.Instance}}" Keys="{x:Static ds:StagePicker.KeyNames}" />
    </StackPanel>
  </Border>
</Window>
