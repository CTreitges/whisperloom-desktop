<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia-Desktop-App. Doku: Context7 /avaloniaui/avalonia-docs, docs/fundamentals/coded-ui.md (abgerufen 2026-10-30). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WhisperLoom</AssemblyName>
    <RootNamespace>WhisperLoom.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/whisperloom.ico</ApplicationIcon>
    <!-- Entwicklungsstand; Pakete setzen die Version beim Publish (build/pack.py: -p:Version=<x.y.z>). -->
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="PortAudioSharp2" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WhisperLoom.Core/WhisperLoom.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WhisperLoom.App.Tests" />
  </ItemGroup>
</Project>
