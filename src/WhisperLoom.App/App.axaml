<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhisperLoom.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Farben aus der Android-UX-Spec (docs/design/ux-spec-v3.md im Android-Repo). -->
    <SolidColorBrush x:Key="WlBackground" Color="#0E1116" />
    <SolidColorBrush x:Key="WlAccent" Color="#6FD9C7" />
    <SolidColorBrush x:Key="WlRecording" Color="#FF4D4D" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
