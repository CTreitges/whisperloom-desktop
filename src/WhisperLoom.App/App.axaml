<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WhisperLoom.App.App"
             Name="WhisperLoom"
             RequestedThemeVariant="Dark">
  <!-- Global dunkel (Bühne, Overlay, Verlauf, Einrichtung); Fenster mit Designsystem folgen dem System (Design/SystemTheme.cs). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Design/Tokens.axaml" />
        <ResourceInclude Source="/Design/Icons.axaml" />
        <ResourceInclude Source="/Design/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Farben aus der Android-UX-Spec v3 §3.1 (docs/design/ux-spec-v3.md im Android-Repo); feste Dunkel-Töne der älteren Fenster. -->
      <SolidColorBrush x:Key="WlBackground" Color="#0E1116" />
      <SolidColorBrush x:Key="WlSurface" Color="#1A1F26" />
      <SolidColorBrush x:Key="WlSurfaceHigh" Color="#2E353E" />
      <SolidColorBrush x:Key="WlOnSurface" Color="#E4E8EE" />
      <SolidColorBrush x:Key="WlOnSurfaceVariant" Color="#B8C0CC" />
      <SolidColorBrush x:Key="WlAccent" Color="#6FD9C7" />
      <SolidColorBrush x:Key="WlSecondary" Color="#A9C4E8" />
      <SolidColorBrush x:Key="WlTertiaryContainer" Color="#54368A" />
      <SolidColorBrush x:Key="WlOnTertiaryContainer" Color="#EEDCFF" />
      <SolidColorBrush x:Key="WlRecording" Color="#FF4D4D" />
      <SolidColorBrush x:Key="WlError" Color="#FFB4AB" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- Loom-Akzent statt System-Akzent für Häkchen, Schalter, Fokus; dunkel #6FD9C7 (Schalter an 9,8:1 statt 2,1:1, zielstruktur.md §5). Doku: docs.avaloniaui.net/docs/basics/user-interface/styling/themes/fluent (abgerufen 2026-11-01). -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F5B50" />
        <ColorPaletteResources x:Key="Dark" Accent="#6FD9C7" />
        <!-- Hochkontrast: Fluent erlaubt hier nur Light/Dark; die Akzentfarben stehen darum im Hochkontrast-Teil von Tokens.axaml. -->
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Design/Styles.axaml" />
  </Application.Styles>
</Application>
