<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:o="using:WhisperLoom.App.Platform.Windows.Overlay"
        xmlns:l="using:WhisperLoom.App.Localization"
        xmlns:ds="using:WhisperLoom.App.Design"
        x:Class="WhisperLoom.App.Platform.Windows.Overlay.OverlayWindow"
        x:DataType="o:OverlayViewModel"
        Title="{Binding [Overlay_Title], Source={x:Static l:Loc.Instance}}"
        Width="560" SizeToContent="Height"
        FontSize="{DynamicResource Loom.Font.Body}"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- Fokusfreies Overlay der Umschalt-Kombi (k3.html): folgt dem Systemthema, Zustand über Symbol und Wort, eine Textkante am
       Innenrand (16), Knöpfe nicht fokussierbar (Ausnahme D5) – die Tastenwege stehen als Tastenkappen in der letzten Zeile. -->
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <!-- Nur Knöpfe mit Fläche bekommen Innenabstand; Textknöpfe bleiben auf der Textkante (Prüfer-Fund). -->
    <Style Selector="Button.secondary, Button.accent">
      <Setter Property="Padding" Value="12,4" />
    </Style>
    <!-- Abstand zu „Pause“; nach einem Fehler steht „Verwerfen“ vorn an der Kante. -->
    <Style Selector="Button#DiscardButton">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Button#DiscardButton.lead">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Button ds|LoomIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Stufe gesperrt (IT, Umschreiben): als Text statt als Akzent-Knopf, damit nichts klickbar wirkt. -->
    <Style Selector="Button.text:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Loom.TextSecondary}" />
    </Style>
    <Style Selector="ds|LoomIcon.state">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border x:Name="Panel" Classes="float" Padding="16"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.LiveSetting="Polite">
    <StackPanel Spacing="{DynamicResource Loom.Space.3}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Panel VerticalAlignment="Center">
          <ds:LoomIcon x:Name="RecordIcon" Classes="state" Data="{DynamicResource Loom.Icon.Record}" Foreground="{DynamicResource Loom.Record}" IsVisible="{Binding IsRecording}" />
          <ds:LoomIcon x:Name="PauseIcon" Classes="state" Data="{DynamicResource Loom.Icon.Pause}" Foreground="{DynamicResource Loom.Text}" IsVisible="{Binding IsPaused}" />
          <ds:LoomIcon x:Name="ProcessingIcon" Classes="state" Data="{DynamicResource Loom.Icon.Processing}" Foreground="{DynamicResource Loom.Accent}" IsVisible="{Binding IsProcessing}" />
          <ds:LoomIcon x:Name="ErrorIcon" Classes="state" Data="{DynamicResource Loom.Icon.Error}" Foreground="{DynamicResource Loom.Error}" IsVisible="{Binding IsError}" />
        </Panel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.3}" Margin="8,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontSize="{DynamicResource Loom.Font.Title}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Loom.Text}" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
          <TextBlock x:Name="ElapsedLabel" Text="{Binding ElapsedText}" FontSize="{DynamicResource Loom.Font.Title}" Foreground="{DynamicResource Loom.TextSecondary}"
                     IsVisible="{Binding CanAct}" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="StageButton" Grid.Column="2" Classes="text" VerticalAlignment="Center" Command="{Binding ToggleStagesCommand}"
                IsVisible="{Binding CanAct}" IsEnabled="{Binding CanPickStage}"
                ToolTip.Tip="{Binding [Overlay_StageTip], Source={x:Static l:Loc.Instance}}"
                AutomationProperties.Name="{Binding StageText}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.1}">
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.TextStage}" />
            <TextBlock Text="{Binding StageText}" VerticalAlignment="Center" />
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.Expand}" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock x:Name="DetailText" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Loom.TextSecondary}"
                 IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Value="{Binding Level}" Height="4" MinHeight="4"
                   Foreground="{DynamicResource Loom.Accent}" Background="{DynamicResource Loom.SurfaceHigh}"
                   IsVisible="{Binding ShowLevel}" IsIndeterminate="{Binding Moving}" />
      <Grid x:Name="PendingRow" ColumnDefinitions="Auto,*" IsVisible="{Binding PreviousPending}">
        <ds:LoomIcon Data="{DynamicResource Loom.Icon.Processing}" Width="16" Height="16" Foreground="{DynamicResource Loom.Accent}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock x:Name="PendingHint" Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Loom.Text}"
                   Text="{Binding [Next_PendingHint], Source={x:Static l:Loc.Instance}}" />
      </Grid>
      <ds:StagePicker x:Name="StagePickerView" DataContext="{Binding StagePicker}" IsVisible="{Binding $parent[Window].((o:OverlayViewModel)DataContext).IsStagePickerOpen}" />
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button x:Name="PauseButton" Classes="secondary" Command="{Binding PauseResumeCommand}" IsVisible="{Binding CanAct}"
                AutomationProperties.Name="{Binding PauseText}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.2}">
            <Panel>
              <ds:LoomIcon Data="{DynamicResource Loom.Icon.Pause}" IsVisible="{Binding !IsPaused}" />
              <ds:LoomIcon Data="{DynamicResource Loom.Icon.Play}" IsVisible="{Binding IsPaused}" />
            </Panel>
            <TextBlock Text="{Binding PauseText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="DiscardButton" Grid.Column="1" Classes="secondary danger" Classes.lead="{Binding IsError}" Command="{Binding DiscardCommand}"
                IsVisible="{Binding ShowDiscard}"
                AutomationProperties.Name="{Binding [Overlay_Discard], Source={x:Static l:Loc.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.2}">
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.Discard}" />
            <TextBlock Text="{Binding [Overlay_Discard], Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SkipButton" Grid.Column="1" Classes="text" Command="{Binding SkipCommand}" IsVisible="{Binding ShowSkip}" IsEnabled="{Binding CanSkip}"
                AutomationProperties.Name="{Binding [Overlay_Skip], Source={x:Static l:Loc.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.1}">
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.Paste}" />
            <TextBlock Text="{Binding [Overlay_Skip], Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="RetryButton" Grid.Column="3" Classes="accent" Command="{Binding RetrySendCommand}" IsVisible="{Binding ShowRetry}"
                AutomationProperties.Name="{Binding [Overlay_Retry], Source={x:Static l:Loc.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.2}">
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.Resend}" />
            <TextBlock Text="{Binding [Overlay_Retry], Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SendButton" Grid.Column="4" Classes="accent" Command="{Binding SendCommand}" IsVisible="{Binding CanAct}"
                AutomationProperties.Name="{Binding [Overlay_Send], Source={x:Static l:Loc.Instance}}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Loom.Space.2}">
            <ds:LoomIcon Data="{DynamicResource Loom.Icon.Send}" />
            <TextBlock Text="{Binding [Overlay_Send], Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <ds:KeycapText x:Name="KeysText" Template="{Binding KeysTemplate}" Keys="{Binding Keys}" FontSize="{DynamicResource Loom.Font.Caption}"
                     Foreground="{DynamicResource Loom.TextSecondary}" IsVisible="{Binding KeysTemplate, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </Border>
</Window>
