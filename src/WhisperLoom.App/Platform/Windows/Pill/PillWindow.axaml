<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:WhisperLoom.App.Platform.Windows.Pill"
        xmlns:l="using:WhisperLoom.App.Localization"
        xmlns:ds="using:WhisperLoom.App.Design"
        x:Class="WhisperLoom.App.Platform.Windows.Pill.PillWindow"
        x:DataType="p:PillViewModel"
        Title="{Binding [Pill_Title], Source={x:Static l:Loc.Instance}}"
        SizeToContent="WidthAndHeight"
        Background="Transparent" TransparencyLevelHint="Transparent">
  <!-- Pegel-Pille beim Halten: fokusfrei, unten mittig auf dem Monitor des Ziels. Nur Symbol und Pegel, kein Wort
       (Entscheidung 14); der Zustand bleibt über die Symbolform unterscheidbar (Aufnahme-Kreis, Verarbeitungs-Pfeile), der
       Name für Screenreader nennt ihn. -->
  <Border x:Name="Panel" Classes="float" CornerRadius="20" Height="40" Padding="12,0"
          AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.LiveSetting="Polite">
    <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Center">
      <Panel VerticalAlignment="Center">
        <ds:LoomIcon x:Name="RecordIcon" Data="{DynamicResource Loom.Icon.Record}" Width="20" Height="20"
                     Foreground="{DynamicResource Loom.Record}" IsVisible="{Binding !Processing}" />
        <ds:LoomIcon x:Name="ProcessingIcon" Data="{DynamicResource Loom.Icon.Processing}" Width="20" Height="20"
                     Foreground="{DynamicResource Loom.Accent}" IsVisible="{Binding Processing}" />
      </Panel>
      <ProgressBar x:Name="LevelBar" Grid.Column="1" Margin="8,0,0,0" Minimum="0" Maximum="1" Value="{Binding Level}"
                   Width="120" Height="6" MinHeight="6" MinWidth="0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Loom.Accent}" Background="{DynamicResource Loom.SurfaceHigh}"
                   IsVisible="{Binding ShowBar}" IsIndeterminate="{Binding Moving}" />
    </Grid>
  </Border>
</Window>
