<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="using:WhisperLoom.App.Design"
             xmlns:l="using:WhisperLoom.App.Localization"
             x:Class="WhisperLoom.App.Design.CustomChoiceBox"
             x:DataType="ds:CustomChoiceViewModel">
  <!--
    Auswahlliste mit „Eigenes …“: beim letzten Eintrag erscheint das Feld „Modell-ID“ mit sichtbarem Label und Hinweis (kein
    Platzhalter, B11/B18); es übernimmt beim Verlassen bzw. Enter. Linksbündig, damit der Rahmen auf der Textkante liegt.
  -->
  <StackPanel Spacing="{DynamicResource Loom.Space.2}" MinWidth="260" MaxWidth="320" HorizontalAlignment="Left">
    <ComboBox x:Name="Box" HorizontalAlignment="Stretch" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" />
    <StackPanel Spacing="2" IsVisible="{Binding IsCustom}">
      <TextBlock Text="{Binding [Custom_Label], Source={x:Static l:Loc.Instance}}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding [Custom_Hint], Source={x:Static l:Loc.Instance}}" Classes="caption" TextWrapping="Wrap" />
      <TextBox x:Name="CustomBox" Text="{Binding CustomText, UpdateSourceTrigger=LostFocus}"
               AutomationProperties.Name="{Binding [Custom_Label], Source={x:Static l:Loc.Instance}}" />
    </StackPanel>
  </StackPanel>
</UserControl>
