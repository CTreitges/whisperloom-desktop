<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ds="using:WhisperLoom.App.Design">
  <!--
    Designsystem (docs/design-system.md, Farbrollen zielstruktur.md §5): Loom-Palette der Android-App (ui/theme/Color.kt).
    Dunkel = die Android-Rollen 1:1; hell = dieselben Töne mit getauschten Rollen; Hochkontrast folgt dem Kontrastdesign des
    Systems (Schwarz, Weiß, Akzent, Gelb nur für den Fokus; SystemTheme.HighContrast, Rückfall Dunkel).
    Neu mit UX-1: Outline (Rahmen von Feldern und Schaltern), Focus (Fokusring), Record (Aufnahme-Symbol).
    Kontraste prüft DesignTokensTest (Text ≥ 4,5:1, Hochkontrast ≥ 7:1, Rahmen und Fokus ≥ 3:1).
    Doku: docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants (abgerufen 2026-11-01).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Loom.Background" Color="#0E1116" />
      <SolidColorBrush x:Key="Loom.Sidebar" Color="#161A20" />
      <SolidColorBrush x:Key="Loom.Surface" Color="#1A1F26" />
      <SolidColorBrush x:Key="Loom.SurfaceHigh" Color="#242A32" />
      <SolidColorBrush x:Key="Loom.Separator" Color="#3A424D" />
      <SolidColorBrush x:Key="Loom.Outline" Color="#8A95A3" />
      <SolidColorBrush x:Key="Loom.SurfaceEdge" Color="#00000000" />
      <SolidColorBrush x:Key="Loom.Text" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.TextSecondary" Color="#B8C0CC" />
      <SolidColorBrush x:Key="Loom.Accent" Color="#6FD9C7" />
      <SolidColorBrush x:Key="Loom.OnAccent" Color="#00382F" />
      <SolidColorBrush x:Key="Loom.Selection" Color="#0F5B50" />
      <SolidColorBrush x:Key="Loom.OnSelection" Color="#B4F2E6" />
      <SolidColorBrush x:Key="Loom.Error" Color="#FFB4AB" />
      <SolidColorBrush x:Key="Loom.Warning" Color="#FFC85C" />
      <SolidColorBrush x:Key="Loom.Managed" Color="#2B4665" />
      <SolidColorBrush x:Key="Loom.OnManaged" Color="#D8E7FA" />
      <SolidColorBrush x:Key="Loom.Focus" Color="#6FD9C7" />
      <SolidColorBrush x:Key="Loom.Record" Color="#FF4D4D" />
      <!-- Fluent: Rahmen von Feldern und Schaltern in Outline (≥ 3:1), Fokusring in Focus. -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#8A95A3" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#8A95A3" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8A95A3" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8A95A3" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#8A95A3" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#8A95A3" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#6FD9C7" />
      <!-- Fluent: Schrift und Knopf auf Akzentflächen in OnAccent (dunkel wäre Weiß auf #6FD9C7 nur 1,7:1). -->
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#00382F" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#00382F" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#00382F" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#00382F" />
      <!-- Fluent: Auswahl in Listen und Feldern in Selection/OnSelection, Akzentflächen in Accent/OnAccent (Review UX-1). -->
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0F5B50" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#0F5B50" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#0F5B50" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#00382F" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#00382F" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#00382F" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#6FD9C7" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#0F5B50" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#0F5B50" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#0F5B50" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#0F5B50" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Loom.Background" Color="#EEF1F5" />
      <SolidColorBrush x:Key="Loom.Sidebar" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.SurfaceHigh" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.Separator" Color="#B8C0CC" />
      <SolidColorBrush x:Key="Loom.Outline" Color="#6B7480" />
      <SolidColorBrush x:Key="Loom.SurfaceEdge" Color="#00000000" />
      <SolidColorBrush x:Key="Loom.Text" Color="#0E1116" />
      <SolidColorBrush x:Key="Loom.TextSecondary" Color="#3A424D" />
      <SolidColorBrush x:Key="Loom.Accent" Color="#0F5B50" />
      <SolidColorBrush x:Key="Loom.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Selection" Color="#B4F2E6" />
      <SolidColorBrush x:Key="Loom.OnSelection" Color="#00382F" />
      <SolidColorBrush x:Key="Loom.Error" Color="#93000A" />
      <SolidColorBrush x:Key="Loom.Warning" Color="#4A3600" />
      <SolidColorBrush x:Key="Loom.Managed" Color="#D8E7FA" />
      <SolidColorBrush x:Key="Loom.OnManaged" Color="#12304F" />
      <SolidColorBrush x:Key="Loom.Focus" Color="#0F5B50" />
      <SolidColorBrush x:Key="Loom.Record" Color="#B3261E" />
      <!-- Fluent: Rahmen von Feldern und Schaltern in Outline (≥ 3:1), Fokusring in Focus. -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#6B7480" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#6B7480" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6B7480" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#6B7480" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#6B7480" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#6B7480" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#0F5B50" />
      <!-- Fluent: Schrift und Knopf auf Akzentflächen in OnAccent (dunkel wäre Weiß auf #6FD9C7 nur 1,7:1). -->
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
      <!-- Fluent: Auswahl in Listen und Feldern in Selection/OnSelection, Akzentflächen in Accent/OnAccent (Review UX-1). -->
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#B4F2E6" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#00382F" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#00382F" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#00382F" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0F5B50" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#0F5B50" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0F5B50" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#0F5B50" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#0F5B50" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#0F5B50" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F5B50" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#B4F2E6" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#B4F2E6" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#B4F2E6" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#B4F2E6" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="{x:Static ds:SystemTheme.HighContrast}">
      <SolidColorBrush x:Key="Loom.Background" Color="#000000" />
      <SolidColorBrush x:Key="Loom.Sidebar" Color="#000000" />
      <SolidColorBrush x:Key="Loom.Surface" Color="#000000" />
      <SolidColorBrush x:Key="Loom.SurfaceHigh" Color="#000000" />
      <SolidColorBrush x:Key="Loom.Separator" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Outline" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.SurfaceEdge" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Text" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.TextSecondary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Accent" Color="#6FD9C7" />
      <SolidColorBrush x:Key="Loom.OnAccent" Color="#000000" />
      <SolidColorBrush x:Key="Loom.Selection" Color="#6FD9C7" />
      <SolidColorBrush x:Key="Loom.OnSelection" Color="#000000" />
      <SolidColorBrush x:Key="Loom.Error" Color="#FFB4AB" />
      <SolidColorBrush x:Key="Loom.Warning" Color="#FFC85C" />
      <SolidColorBrush x:Key="Loom.Managed" Color="#000000" />
      <SolidColorBrush x:Key="Loom.OnManaged" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Focus" Color="#FFFF00" />
      <SolidColorBrush x:Key="Loom.Record" Color="#FF6B6B" />
      <!-- Fluent: Rahmen von Feldern und Schaltern in Outline (≥ 3:1), Fokusring in Focus. -->
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFFF00" />
      <!-- Fluent: Schrift und Knopf auf Akzentflächen in OnAccent (dunkel wäre Weiß auf #6FD9C7 nur 1,7:1). -->
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#000000" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#000000" />
      <!-- Fluent: Auswahl in Listen und Feldern in Selection/OnSelection, Akzentflächen in Accent/OnAccent (Review UX-1). -->
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#6FD9C7" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#6FD9C7" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#000000" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#6FD9C7" />
      <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#6FD9C7" />
      <!-- Platzhalter: Fluent dimmt ihn auf 30 % – im Hochkontrast 2,4:1; hier volles Weiß (Suchfelder bekommen in UX-2 ein Label, D8). -->
      <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FFFFFF" />
      <!-- Fluent-Akzent: Paletten gibt es nur für Light/Dark, Hochkontrast setzt die Farben selbst. -->
      <Color x:Key="SystemAccentColor">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorLight1">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorLight2">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorLight3">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorDark1">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorDark2">#6FD9C7</Color>
      <Color x:Key="SystemAccentColorDark3">#6FD9C7</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Symbol-Kacheln der Seitenleiste: fest, weiße Glyphe auf dunklem Container-Ton (alle Varianten). -->
  <SolidColorBrush x:Key="Loom.Tile.Teal" Color="#0F5B50" />
  <SolidColorBrush x:Key="Loom.Tile.Blue" Color="#2B4665" />
  <SolidColorBrush x:Key="Loom.Tile.Violet" Color="#54368A" />
  <SolidColorBrush x:Key="Loom.Tile.Red" Color="#93000A" />
  <SolidColorBrush x:Key="Loom.Tile.Green" Color="#123D24" />
  <SolidColorBrush x:Key="Loom.Tile.Amber" Color="#4A3600" />
  <SolidColorBrush x:Key="Loom.Tile.Gray" Color="#3A424D" />

  <!-- Abstände (zielstruktur.md §4): nur 4 / 8 / 12 / 16 / 24 / 32 / 48. -->
  <x:Double x:Key="Loom.Space.1">4</x:Double>
  <x:Double x:Key="Loom.Space.2">8</x:Double>
  <x:Double x:Key="Loom.Space.3">12</x:Double>
  <x:Double x:Key="Loom.Space.4">16</x:Double>
  <x:Double x:Key="Loom.Space.5">24</x:Double>
  <x:Double x:Key="Loom.Space.6">32</x:Double>
  <x:Double x:Key="Loom.Space.7">48</x:Double>
  <CornerRadius x:Key="Loom.Radius.Group">10</CornerRadius>
  <CornerRadius x:Key="Loom.Radius.Control">6</CornerRadius>

  <!-- Typo-Skala (zielstruktur.md §3), Größen bei 100 %; TextScale multipliziert sie mit der Textgröße des Systems. -->
  <x:Double x:Key="Loom.Font.Caption">12</x:Double>
  <x:Double x:Key="Loom.Font.Body">14</x:Double>
  <x:Double x:Key="Loom.Font.Title">16</x:Double>
  <x:Double x:Key="Loom.Font.PageTitle">20</x:Double>
  <x:Double x:Key="Loom.Font.WindowTitle">24</x:Double>
  <x:Double x:Key="Loom.Font.Display">32</x:Double>
</ResourceDictionary>
