<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Designsystem W2-UI1 (docs/design-system.md): Farb-Tokens hell/dunkel aus der Loom-Palette der Android-App
    (ui/theme/Color.kt, LoomPalette). Dunkel = die Android-Rollen 1:1; hell = dieselben Töne mit getauschten Rollen
    (dunkle Töne als Text/Akzent, helle als Fläche). Kontrast ≥ 4,5:1 prüft DesignTokensTest.
    Doku: docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants (abgerufen 2026-11-01).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Loom.BackgroundColor">#0E1116</Color>
      <Color x:Key="Loom.SidebarColor">#161A20</Color>
      <Color x:Key="Loom.SurfaceColor">#1A1F26</Color>
      <Color x:Key="Loom.SurfaceHighColor">#242A32</Color>
      <Color x:Key="Loom.SeparatorColor">#3A424D</Color>
      <Color x:Key="Loom.TextColor">#E4E8EE</Color>
      <Color x:Key="Loom.TextSecondaryColor">#B8C0CC</Color>
      <Color x:Key="Loom.AccentColor">#6FD9C7</Color>
      <Color x:Key="Loom.OnAccentColor">#00382F</Color>
      <Color x:Key="Loom.SelectionColor">#0F5B50</Color>
      <Color x:Key="Loom.OnSelectionColor">#B4F2E6</Color>
      <Color x:Key="Loom.ErrorColor">#FFB4AB</Color>
      <Color x:Key="Loom.WarningColor">#FFC85C</Color>
      <Color x:Key="Loom.ManagedColor">#2B4665</Color>
      <Color x:Key="Loom.OnManagedColor">#D8E7FA</Color>
      <SolidColorBrush x:Key="Loom.Background" Color="#0E1116" />
      <SolidColorBrush x:Key="Loom.Sidebar" Color="#161A20" />
      <SolidColorBrush x:Key="Loom.Surface" Color="#1A1F26" />
      <SolidColorBrush x:Key="Loom.SurfaceHigh" Color="#242A32" />
      <SolidColorBrush x:Key="Loom.Separator" Color="#3A424D" />
      <SolidColorBrush x:Key="Loom.Text" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.TextSecondary" Color="#B8C0CC" />
      <SolidColorBrush x:Key="Loom.Accent" Color="#6FD9C7" />
      <SolidColorBrush x:Key="Loom.OnAccent" Color="#00382F" />
      <SolidColorBrush x:Key="Loom.Selection" Color="#0F5B50" />
      <SolidColorBrush x:Key="Loom.OnSelection" Color="#B4F2E6" />
      <SolidColorBrush x:Key="Loom.Error" Color="#FFB4AB" />
      <SolidColorBrush x:Key="Loom.Warning" Color="#FFC85C" />
      <SolidColorBrush x:Key="Loom.Managed" Color="#2B4665" />
      <SolidColorBrush x:Key="Loom.OnManaged" Color="#D8E7FA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Loom.BackgroundColor">#EEF1F5</Color>
      <Color x:Key="Loom.SidebarColor">#E4E8EE</Color>
      <Color x:Key="Loom.SurfaceColor">#FFFFFF</Color>
      <Color x:Key="Loom.SurfaceHighColor">#E4E8EE</Color>
      <Color x:Key="Loom.SeparatorColor">#B8C0CC</Color>
      <Color x:Key="Loom.TextColor">#0E1116</Color>
      <Color x:Key="Loom.TextSecondaryColor">#3A424D</Color>
      <Color x:Key="Loom.AccentColor">#0F5B50</Color>
      <Color x:Key="Loom.OnAccentColor">#FFFFFF</Color>
      <Color x:Key="Loom.SelectionColor">#B4F2E6</Color>
      <Color x:Key="Loom.OnSelectionColor">#00382F</Color>
      <Color x:Key="Loom.ErrorColor">#93000A</Color>
      <Color x:Key="Loom.WarningColor">#4A3600</Color>
      <Color x:Key="Loom.ManagedColor">#D8E7FA</Color>
      <Color x:Key="Loom.OnManagedColor">#12304F</Color>
      <SolidColorBrush x:Key="Loom.Background" Color="#EEF1F5" />
      <SolidColorBrush x:Key="Loom.Sidebar" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.Surface" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.SurfaceHigh" Color="#E4E8EE" />
      <SolidColorBrush x:Key="Loom.Separator" Color="#B8C0CC" />
      <SolidColorBrush x:Key="Loom.Text" Color="#0E1116" />
      <SolidColorBrush x:Key="Loom.TextSecondary" Color="#3A424D" />
      <SolidColorBrush x:Key="Loom.Accent" Color="#0F5B50" />
      <SolidColorBrush x:Key="Loom.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Loom.Selection" Color="#B4F2E6" />
      <SolidColorBrush x:Key="Loom.OnSelection" Color="#00382F" />
      <SolidColorBrush x:Key="Loom.Error" Color="#93000A" />
      <SolidColorBrush x:Key="Loom.Warning" Color="#4A3600" />
      <SolidColorBrush x:Key="Loom.Managed" Color="#D8E7FA" />
      <SolidColorBrush x:Key="Loom.OnManaged" Color="#12304F" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>


  <!-- Symbol-Kacheln der Seitenleiste: fest, weiße Glyphe auf dunklem Container-Ton (beide Varianten). -->
  <SolidColorBrush x:Key="Loom.Tile.Teal" Color="#0F5B50" />
  <SolidColorBrush x:Key="Loom.Tile.Blue" Color="#2B4665" />
  <SolidColorBrush x:Key="Loom.Tile.Violet" Color="#54368A" />
  <SolidColorBrush x:Key="Loom.Tile.Red" Color="#93000A" />
  <SolidColorBrush x:Key="Loom.Tile.Green" Color="#123D24" />
  <SolidColorBrush x:Key="Loom.Tile.Amber" Color="#4A3600" />
  <SolidColorBrush x:Key="Loom.Tile.Gray" Color="#3A424D" />

  <!-- Abstände (4er-Raster), Radien, Schrift. -->
  <x:Double x:Key="Loom.Space.XS">4</x:Double>
  <x:Double x:Key="Loom.Space.S">8</x:Double>
  <x:Double x:Key="Loom.Space.M">12</x:Double>
  <x:Double x:Key="Loom.Space.L">16</x:Double>
  <x:Double x:Key="Loom.Space.XL">24</x:Double>
  <CornerRadius x:Key="Loom.Radius.Group">10</CornerRadius>
  <CornerRadius x:Key="Loom.Radius.Control">6</CornerRadius>
  <x:Double x:Key="Loom.Font.PageTitle">22</x:Double>
  <x:Double x:Key="Loom.Font.GroupTitle">13</x:Double>
  <x:Double x:Key="Loom.Font.Body">14</x:Double>
  <x:Double x:Key="Loom.Font.Caption">12</x:Double>

