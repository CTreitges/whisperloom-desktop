<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3: Testprojekte sind ausführbar (OutputType Exe). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WhisperLoom.Core/WhisperLoom.Core.csproj" />
  </ItemGroup>
</Project>
