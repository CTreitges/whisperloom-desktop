<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3: Testprojekte sind ausführbar (OutputType Exe). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WhisperLoom.Core/WhisperLoom.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Format-Fixtures (docs/settings-format.md), dieselben Dateien nutzt Android (WLD-P5c). -->
    <None Include="../fixtures/settings-v1*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
