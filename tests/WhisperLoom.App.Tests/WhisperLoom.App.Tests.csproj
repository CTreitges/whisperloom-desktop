<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia.Headless + xUnit v3. Doku: Context7 /avaloniaui/avalonia-docs, docs/testing/headless-xunit.md (abgerufen 2026-10-30). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Headless-Tests laufen auf dem Avalonia-UI-Thread; CancellationToken.None statt TestContext ist hier gewollt. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WhisperLoom.App/WhisperLoom.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Derselbe lokale Fake-HTTP-Server wie in den Core-Tests (Fake-Proxy für AppPipelineTest). -->
    <Compile Include="../WhisperLoom.Core.Tests/Support/FakeServer.cs" Link="Support/FakeServer.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../fixtures/settings-v1*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
