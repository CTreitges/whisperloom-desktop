<?xml version="1.0" encoding="utf-8"?>
<!-- Review N-19: Pakete nur von nuget.org, Quellen aus Benutzer- bzw. Maschinen-Konfig zählen nicht (kein Dependency
     Confusion über eine zusätzliche Quelle). Doku: learn.microsoft.com/nuget/consume-packages/package-source-mapping
     (abgerufen 2026-11-11). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
